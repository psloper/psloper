# Copy this file to .env and fill in your own values.

# --- Claude (required) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
MAX_GEN_RETRIES=2

# --- CAD script sandbox ---
GEN_TIMEOUT_SECONDS=60
GEN_MEMORY_LIMIT_MB=1024

# --- Storage ---
GENERATED_DIR=./generated

# --- Slicer (PrusaSlicer CLI) ---
# Path to the PrusaSlicer executable (or `prusa-slicer` if it's on your PATH).
PRUSASLICER_PATH=prusa-slicer
# A printer profile exported from PrusaSlicer for YOUR printer/filament/nozzle.
# See README "Setting up your printer profile".
PRINTER_PROFILE=./profiles/default.ini
SLICE_TIMEOUT_SECONDS=180

# --- OctoPrint (required to actually send a print) ---
# e.g. http://octopi.local or http://192.168.1.50
OCTOPRINT_URL=
# OctoPrint Settings -> API -> API Key
OCTOPRINT_API_KEY=

# --- Server ---
HOST=127.0.0.1
PORT=5000
DEBUG=false
